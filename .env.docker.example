# Copy this file to .env.docker before running docker compose.

# Local Docker Desktop URLs.
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Embedded into the frontend at build time; rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# External hosted MongoDB connection string.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/SANIACLOTHING?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# For initial HTTP-only testing on an IP, keep these values.
# Once your site is served over HTTPS, use COOKIE_SECURE=true and COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email for password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Drive invoice archive OAuth (server-side only).
# All four values are REQUIRED: docker-compose.yml refuses to start without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be the public API origin + /api/v1/invoice-archives/google/callback, and must be
# registered character-for-character as an Authorized redirect URI in Google Cloud Console.
#   Docker Desktop: http://localhost:4000/api/v1/invoice-archives/google/callback
#   Production:     https://<your-domain>/api/v1/invoice-archives/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Generate with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
